# --- Airtable ---
# Personal access token with data.records:read + data.records:write on Master Data Hub
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.xxxxxxxx
AIRTABLE_BASE_ID=appWMtageZUg0hsJz
AIRTABLE_WEBSITES_TABLE=tblwWp9in2sdbOaCq
AIRTABLE_LOG_TABLE=tbl4j98qkb5nPwARM
# Optional: restrict to one Airtable view (leave blank for the whole table)
AIRTABLE_VIEW=

# --- Who can sign in ---
# Anyone on these domains can sign in. Add a salesperson by giving them an
# address on the domain — no redeploy needed.
ALLOWED_EMAIL_DOMAINS=postmarketpublishing.com
# Individual extras (contractors, gmail addresses), comma separated. Optional.
ALLOWED_EMAILS=

# Any long random string. Signs the session cookie and the sign-in codes.
# Generate with: openssl rand -hex 32
# Changing this signs everyone out and invalidates codes in flight.
SESSION_SECRET=change-me-to-something-random

# --- Sending the sign-in code ---
# Free Resend account: resend.com. Leave blank while testing and the code is
# printed to the Vercel function log instead of being emailed.
RESEND_API_KEY=
MAIL_FROM=PMP Pricing <pricing@postmarketpublishing.com>

# TESTING ONLY. With this true and RESEND_API_KEY blank, the sign-in code is shown
# on screen instead of emailed, so you can test before setting up email.
# Anyone on the allowlist can then sign in as anyone else on it. Turn it off
# before sales touch this.
SETUP_MODE=false

# Optional. Value written to the Source single-select on each log record.
# Must exactly match an existing choice, or leave blank to skip the field.
# Existing choices: "Canvas - Sales Console", "Bulk edit", "Other".
# Add a "Sales Console (web app)" choice in Airtable, then set it here.
LOG_SOURCE=

# Set to true once the Sellable field is filled in. The server then only ever
# sends sites marked Sellable = Yes to the browser.
SELLABLE_ONLY=false

# Minutes to cache the site list in memory before refetching from Airtable
CACHE_MINUTES=5
