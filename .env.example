# --- Airtable ---
# Personal access token with data.records:read + data.records:write on Master Data Hub
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.xxxxxxxx
AIRTABLE_BASE_ID=appWMtageZUg0hsJz
AIRTABLE_WEBSITES_TABLE=tblwWp9in2sdbOaCq
AIRTABLE_LOG_TABLE=tbl4j98qkb5nPwARM
# Pending/approved price change requests raised by sales.
AIRTABLE_REQUESTS_TABLE=tblW1rDpxbKOAhgCk
# Optional: restrict to one Airtable view (leave blank for the whole table)
AIRTABLE_VIEW=

# Any long random string. Signs the session cookie.
# Generate with: openssl rand -hex 32
# Changing this signs everyone out.
SESSION_SECRET=change-me-to-something-random

# --- Who can do what ---
# There is no password. People sign in with an email address and the role
# follows from it:
#   any other domain          -> customer  read-only, sellable sites only
#   a staff domain below      -> sales     can request a price change
#   ...and in APPROVER_EMAILS -> approver  can approve, and can edit directly
#
# NOTE: the address is not verified, so a role is a claim, not proof. Anyone
# could type a staff address. Approvals record what was typed.
STAFF_EMAIL_DOMAINS=postmarketpublishing.com

# Who may approve price changes. Comma separated. Must be on a staff domain.
# Changing this takes effect immediately — no need to sign anyone out.
APPROVER_EMAILS=

# Optional. Value written to the Source single-select on each log record.
# Must exactly match an existing choice, or leave blank to skip the field.
# Existing choices: "Canvas - Sales Console", "Bulk edit", "Other".
# Add a "Sales Console (web app)" choice in Airtable, then set it here.
LOG_SOURCE=

# Set to true once the Sellable field is filled in. The server then only ever
# sends sites marked Sellable = Yes to the browser.
SELLABLE_ONLY=false

# Minutes to cache the site list in memory before refetching from Airtable
CACHE_MINUTES=5
